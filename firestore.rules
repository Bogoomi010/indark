rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Static config: readable by anyone (or lock to signed-in if you prefer)
    match /configs/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Runs: client can read only their own run data; all writes go through Cloud Functions.
    match /runs/{runId} {
      allow read: if isSignedIn() && resource.data.playerUid == request.auth.uid;
      allow write: if false;

      match /{subCollection=**}/{docId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/runs/$(runId)).data.playerUid == request.auth.uid;
        allow write: if false;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
